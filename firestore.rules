rules_version = '2';

// ---------------------------------------------------------------------
// Like تشفير, this game runs entirely in the browser — no Cloud
// Functions, which is what keeps it on the free Spark plan. Clients do
// the writing, so these rules can't enforce game logic; correctness is
// protected by Firestore transactions with idempotency guards
// (src/lib/engine.ts).
//
// ONE PLACE WHERE THIS GAME IS STRICTER THAN تشفير:
//
// In تشفير, a peek at the opponent's round code is cheating at the
// margins and the rules let it go. Here, seeing the card IS the game —
// a guesser who reads it has nothing left to play. So the live card is
// sealed at the database layer: readable only by the clue-giver and
// (during live) the judge. During steal the original judge sits out,
// so they lose the read. Writable only by the clue-giver. It costs
// one get() per access and it's worth it.
//
// What these rules still DON'T stop: a clue-giver could award themselves
// points they didn't earn. Deliberate — see the Trust model in README.
// ---------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function inRoom(roomId) {
      return signedIn() && request.auth.uid in roomData(roomId).players;
    }

    match /rooms/{roomId} {
      // createRoom does tx.get on a missing doc (resource == null).
      // joinRoom reads a lobby before the joiner is in players.
      // Mid-game, members only.
      allow get: if signedIn() && (
                   resource == null
                   || request.auth.uid in resource.data.players
                   || resource.data.phase == 'lobby'
                 );
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.auth.uid in request.resource.data.players;
      allow update: if signedIn()
                    && (request.auth.uid in resource.data.players
                        || request.auth.uid in request.resource.data.players);
      // Last player out deletes the room.
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
    }

    // The live card. This is the whole secret of the game.
    match /rooms/{roomId}/secret/card {
      function role(field) {
        return roomData(roomId).turn != null
               && roomData(roomId).turn[field] == request.auth.uid;
      }
      allow read: if inRoom(roomId) && (
        role('clueGiverUid')
        || (role('judgeUid') && roomData(roomId).phase == 'live')
      );
      // Only the describer deals — one writer, so the deck can't fork.
      allow create, update: if inRoom(roomId) && role('clueGiverUid');
      // Clearing a spent card is not a leak (the word is already in the
      // public log). The describer awards or skips the steal, the host
      // recovers stuck turns, and any phone may drive the clock — all
      // of those paths delete this doc inside the same transaction that
      // ends the turn.
      allow delete: if inRoom(roomId);
    }

    // Finished turns. Public to the table by the time they exist — they
    // are what the recap and the end-of-game stats are built from.
    match /rooms/{roomId}/rounds/{roundId} {
      allow read, write: if inRoom(roomId);
    }

    // Per-device clock ping. serverTimestamp in, read back, so every
    // phone can count the same phaseEndsAt even when wall clocks differ.
    // Never the room — a clock write must not touch game state.
    match /clock/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
